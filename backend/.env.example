APP_ENV=production
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Driver: mysql (padrão, XAMPP/local) ou pgsql (Supabase/Postgres).
# Supabase: DB_DRIVER=pgsql, DB_HOST=db.<ref>.supabase.co (ou pooler
# aws-0-<regiao>.pooler.supabase.com), DB_PORT=6543 (pooler) ou 5432
# (direta), DB_NAME=postgres, DB_USER=postgres, DB_PASS=<db password>.
# Schema: database/schema-pg.sql + seed-pg.sql (via SQL Editor).
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=transcamacari
DB_USER=root
DB_PASS=

SESSION_NAME=TCSESSID
SESSION_SECURE=false
SESSION_SAMESITE=Lax
# Deploy com frontend e backend em domínios diferentes (ex.: Vercel +
# Railway): SESSION_SECURE=true e SESSION_SAMESITE=None (cookies precisam
# de HTTPS nos dois lados). FRONTEND_URL deve ser o domínio da Vercel.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_TO=contato@example.com
SMTP_ENCRYPTION=tls
